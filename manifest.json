{
  "schemaVersion": 1,
  "id": "codeofficer.agent-usage",
  "name": "Agent Usage",
  "version": "0.2.0",
  "author": "CodeOfficer (fork of Rob Zolkos)",
  "license": "MIT",
  "description": "Weekly Claude, Codex and Gemini usage in the Omarchy bar, with reset countdowns and prorated pace in the panel.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Agent Usage",
    "description": "Claude, Codex and Gemini weekly usage at a glance.",
    "category": "AI",
    "aliases": [
      "agent-usage",
      "claude-usage",
      "codex-usage",
      "gemini-usage"
    ],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 300
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 60,
        "max": 3600,
        "step": 60,
        "defaultValue": 300
      }
    ]
  }
}
