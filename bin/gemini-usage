#!/usr/bin/env python3
"""Print Google AI Pro usage for the Subscription Usage widget, as one JSON record.

Omarchy's `omarchy-agent-usage-agy` collector supplies the base record: plan,
sign-in help, and the local token history. It reads only Google's quota
*summary*, which on AI Pro lists just the "Claude and GPT models" group. The
Gemini pool is reported only by the per-model call the Gemini CLI uses,
v1internal:retrieveUserQuota, so this asks that too and puts the Gemini pool
first.

Output adds `quotaPools` to the usual record: one entry per group of models
that share a quota (same family, same remaining fraction, same reset), so the
panel can show the per-model breakdown.

The sign-in is read with Omarchy's own collector code and never printed or
stored. Every value from Google is bounded and validated before it is printed.

agy's access token lasts an hour and only a running agy renews it, so Gemini
would read "Limits paused" an hour after agy closes. When that happens and
omp is signed in to Antigravity (`omp login antigravity-cli`, once), this
asks `omp token antigravity-cli` instead: omp renews its own token. omp is
only called when its sign-in exists, so a bare Omarchy lazy-install shim is
never triggered.
"""

import importlib.machinery
import importlib.util
import json
import math
import os
import re
import shutil
import sqlite3
import subprocess
import sys
import time
from pathlib import Path

sys.dont_write_bytecode = True
# Omarchy's Antigravity collector, found on PATH like any Omarchy command;
# AGENT_USAGE_AGY_COLLECTOR points elsewhere (a dev checkout of Omarchy).
COLLECTOR = os.environ.get("AGENT_USAGE_AGY_COLLECTOR") or shutil.which("omarchy-agent-usage-agy") or "omarchy-agent-usage-agy"
MAX_BUCKETS = 64
MODEL_ID = re.compile(r"^[A-Za-z0-9._-]{1,80}$")
GOOGLE_TOKEN = re.compile(r"^ya29\.[A-Za-z0-9._-]{20,4096}$")
OMP_PROVIDER = "antigravity-cli"
OMP_SETUP = "To keep Gemini current without agy open, sign omp in once: choose Set up in the panel, or run `omp login antigravity-cli`."

# Families in the order the panel lists them, with the names people know.
FAMILIES = (
  ("gemini", "Gemini"),
  ("claude", "Claude (in Antigravity)"),
  ("gpt", "GPT (in Antigravity)"),
  ("tab", "Tab completion"),
)


def base_record():
  try:
    out = subprocess.run([COLLECTOR, "--limits-only"], capture_output=True, text=True, timeout=60)
    record = json.loads(out.stdout) if out.returncode == 0 else None
  except Exception:
    record = None
  return record if isinstance(record, dict) else {"schemaVersion": 1, "limits": [], "recentDays": []}


def load_collector():
  if not os.path.isfile(COLLECTOR):
    raise FileNotFoundError(COLLECTOR)
  loader = importlib.machinery.SourceFileLoader("omarchy_agy", COLLECTOR)
  spec = importlib.util.spec_from_loader("omarchy_agy", loader)
  module = importlib.util.module_from_spec(spec)
  loader.exec_module(module)
  return module


def omp_database():
  return Path(os.environ.get("AGENT_USAGE_OMP_DB") or (Path.home() / ".omp" / "agent" / "agent.db"))


def omp_signed_in(db=None):
  """omp keeps an Antigravity sign-in (so omp is installed, not just a shim)."""
  db = db or omp_database()
  if not db.is_file():
    return False
  try:
    conn = sqlite3.connect(f"file:{db}?mode=ro", uri=True, timeout=2)
    try:
      row = conn.execute("SELECT 1 FROM auth_credentials WHERE provider = ? AND disabled_cause IS NULL LIMIT 1", (OMP_PROVIDER,)).fetchone()
    finally:
      conn.close()
  except sqlite3.Error:
    return False
  return row is not None


def omp_token(run=subprocess.run):
  """A live Google token from omp, which renews its own sign-in; or None."""
  if not omp_signed_in():
    return None
  omp = shutil.which("omp")
  if not omp:
    return None
  try:
    out = run([omp, "token", OMP_PROVIDER], stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=30, cwd=str(Path.home()))
  except (OSError, subprocess.SubprocessError):
    return None
  token = str(out.stdout or "").strip()
  return token if out.returncode == 0 and GOOGLE_TOKEN.match(token) else None


def family_of(model_id):
  lowered = model_id.lower()
  for prefix, name in FAMILIES:
    if lowered.startswith(prefix):
      return prefix, name
  return "other", "Other models"


def fraction(value):
  try:
    number = float(value)
  except (TypeError, ValueError):
    return None
  return min(1.0, max(0.0, number)) if math.isfinite(number) else None


def reset_time(value):
  text = str(value or "")
  return text if re.match(r"^\d{4}-\d{2}-\d{2}T[\d:.]+(Z|[+-]\d{2}:\d{2})$", text) else ""


def quota_pools(buckets):
  pools = {}
  for bucket in buckets[:MAX_BUCKETS]:
    if not isinstance(bucket, dict):
      continue
    model = str(bucket.get("modelId") or "")
    remaining = fraction(bucket.get("remainingFraction"))
    if not MODEL_ID.match(model) or remaining is None:
      continue
    family, name = family_of(model)
    reset = reset_time(bucket.get("resetTime"))
    key = (family, round(remaining, 6), reset)
    pool = pools.setdefault(key, {"family": family, "name": name, "used": round(1.0 - remaining, 4), "resetsAt": reset, "models": []})
    pool["models"].append(model)
  order = {prefix: i for i, (prefix, _) in enumerate(FAMILIES)}
  return sorted(pools.values(), key=lambda p: (order.get(p["family"], 99), -p["used"]))


def summary_limits(summary):
  """The quota summary's groups other than Gemini, as extra limit rows."""
  rows = []
  groups = summary.get("groups") if isinstance(summary, dict) else None
  for group in groups if isinstance(groups, list) else []:
    if not isinstance(group, dict) or "gemini" in str(group.get("displayName") or "").lower():
      continue
    short = "Claude/GPT" if "claude" in str(group.get("displayName") or "").lower() else "Other"
    for bucket in group.get("buckets") or []:
      if not isinstance(bucket, dict):
        continue
      remaining = fraction(bucket.get("remainingFraction"))
      if remaining is None:
        continue
      window = str(bucket.get("window") or "").lower()
      title = f"{short} {'weekly' if window == 'weekly' else '5-hour'}"
      # Scoped to some models, so the panel lists it with the models rather
      # than as one of the plan's own limits.
      rows.append({"label": title, "title": title, "percent": round(1.0 - remaining, 4), "resetsAt": reset_time(bucket.get("resetTime")), "scope": "models"})
  return rows


def field_names(objects):
  """The keys Google used across these objects: the debug view compares them
  with the ones the widget was built against, to spot new or dropped data."""
  names = set()
  for item in objects[:MAX_BUCKETS]:
    if isinstance(item, dict):
      names.update(k for k in item.keys() if isinstance(k, str) and len(k) <= 64)
  return sorted(names)[:64]


def google_fields(quota, summary):
  buckets = quota.get("buckets") if isinstance(quota, dict) else None
  groups = summary.get("groups") if isinstance(summary, dict) else None
  groups = groups if isinstance(groups, list) else []
  group_buckets = [b for g in groups if isinstance(g, dict) for b in (g.get("buckets") or []) if isinstance(b, dict)]
  return {
    "quota": field_names([quota]) if isinstance(quota, dict) else [],
    "quotaBucket": field_names(buckets if isinstance(buckets, list) else []),
    "summary": field_names([summary]) if isinstance(summary, dict) else [],
    "summaryGroup": field_names(groups),
    "summaryBucket": field_names(group_buckets),
  }


def main():
  record = base_record()
  record["name"] = "Gemini"
  setup = not omp_signed_in()
  # Same keys every run: which sign-in answered, and whether the omp setup
  # step would help (the panel offers it while Gemini has no live answer).
  record.update(tokenSource="", setupNeeded=setup)
  try:
    agy = load_collector()
    now = time.time()
    entries = [e for e in agy.logins() if agy.token_fresh(e, now)]
    token, source = (entries[0]["accessToken"], entries[0].get("source") or "agy") if entries else (omp_token(), "omp")
    if not token:
      raise LookupError
    assist = agy.post("loadCodeAssist", token)
    body = agy.project_body(assist)
    quota = agy.post("retrieveUserQuota", token, body)
    summary = agy.post("retrieveUserQuotaSummary", token, body)
  except LookupError:
    # No live sign-in: keep the base record's own status and help text.
    if setup and record.get("authHelpText"):
      record["authHelpText"] = str(record["authHelpText"]) + " " + OMP_SETUP
    print(json.dumps(record))
    return
  except Exception:
    record["usageStatusText"] = "Gemini quota unavailable"
    print(json.dumps(record))
    return

  buckets = quota.get("buckets") if isinstance(quota, dict) else None
  pools = quota_pools(buckets if isinstance(buckets, list) else [])
  limits = []
  gemini = next((p for p in pools if p["family"] == "gemini"), None)
  if gemini:
    # Google reports only a rolling 5-hour window for the Gemini pool.
    limits.append({"label": "Gemini (5-hour)", "title": "Gemini", "percent": gemini["used"], "resetsAt": gemini["resetsAt"], "primary": True})
  limits.extend(summary_limits(summary))
  # A live answer, whichever sign-in gave it: the base record's "paused"
  # notice and stale flag no longer apply.
  record.update(limits=limits, quotaPools=pools, googleFields=google_fields(quota, summary), usageStatusText="", authHelpText="",
                limitsStale=False, limitsFetchedAt=int(now * 1000), tokenSource=source)
  print(json.dumps(record))


if __name__ == "__main__":
  main()
